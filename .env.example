# Projet Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL publique de l'app (liens magiques / réinitialisation de mot de passe)
