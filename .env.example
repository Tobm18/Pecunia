# PostgreSQL (Neon : URL « pooled » pour l'app, URL directe pour les migrations)
DATABASE_URL=postgres://postgres:pecunia@localhost:5432/postgres
DATABASE_URL_UNPOOLED=

# Better Auth : secret de signature des sessions (openssl rand -base64 32) et URL publique
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Autorise la création de compte depuis /inscription (usage personnel : désactiver après la 1re inscription)
NEXT_PUBLIC_ALLOW_SIGNUP=true

# Connexion bancaire (Enable Banking, lecture seule) : identifiant de l'application et clé privée
# RSA (PEM sur une seule ligne, retours à la ligne écrits « \n »). Ne jamais committer la clé.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Nom exact de la banque dans la liste Enable Banking (défaut : Banque Populaire Méditerranée)
ENABLE_BANKING_ASPSP=
# URL de retour enregistrée chez Enable Banking (défaut : BETTER_AUTH_URL + /api/integrations/bank/callback)
ENABLE_BANKING_REDIRECT_URL=
# Secret du cron de synchronisation quotidienne (openssl rand -base64 32) ; Vercel l'envoie en Bearer
CRON_SECRET=

# Notifications push (Web Push) : clés VAPID générées par « npx web-push generate-vapid-keys ».
# La clé publique est lue par le navigateur (intégrée au build : redéployer après l'avoir ajoutée).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services de push (mailto: ou https:, défaut : BETTER_AUTH_URL)
VAPID_SUBJECT=
